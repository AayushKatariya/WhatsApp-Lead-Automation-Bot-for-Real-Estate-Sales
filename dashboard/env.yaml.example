# Copy this file to env.yaml and fill it in. env.yaml holds secrets: never share it.
# .gcloudignore keeps it out of the upload.

# Neon > your project > Connect > connection string (the same one the bot's DATABASE_URL uses)
DATABASE_URL: "postgresql://neondb_owner:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# The dashboard's own address: the Service URL printed by the first deploy, without a trailing /
APP_URL: "https://lead-dashboard-abc123xyz-el.a.run.app"

# Google Cloud > Google Auth Platform > Clients > your Web client
GOOGLE_CLIENT_ID: "123456789012-abc.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET: "GOCSPX-..."

# A long random phrase that locks the sign-in cookies (at least 32 characters). Changing it signs everyone out.
SESSION_SECRET: "paste-the-output-of: openssl rand -base64 32"

# Owners who can always sign in and manage the Team page, comma-separated
OWNER_EMAILS: "owner@gmail.com"
