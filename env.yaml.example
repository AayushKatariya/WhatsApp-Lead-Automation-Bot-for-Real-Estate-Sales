# Copy this file to env.yaml and fill it in. env.yaml holds your secrets:
# never share it or send it to anyone. .gcloudignore keeps it out of the upload.

# Meta (App Dashboard > WhatsApp > API Setup, and Business Settings > System users)
WA_TOKEN: "EAAG...your permanent system-user token"
WA_PHONE_NUMBER_ID: "123456789012345"
WA_VERIFY_TOKEN: "make-up-a-long-random-phrase"
WA_APP_SECRET: "App Dashboard > App settings > Basic > App secret"
GRAPH_API_VERSION: "v26.0"

# Google Sheet: the long ID between /d/ and /edit in the sheet's address
SHEET_ID: "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# How the bot introduces you, and who gets leads when a project has no salesperson listed
COMPANY_NAME: "Shree Builders"
DEFAULT_SALES_NAME: "Shree Builders Sales"
DEFAULT_SALES_PHONE: "+91 98765 43210"

# Optional: WhatsApp alerts to sales (needs an approved template, see the guide).
# Who gets them is set per project in the Sites tab's alert_phones column.
SALES_ALERT_TEMPLATE: ""
SALES_ALERT_LANGUAGE: "en"
# "handoffs" = alert on site-visit requests, Talk to sales and questions the bot can't answer
# "all"      = also alert as soon as a customer opens a project's details
SALES_ALERT_ON: "handoffs"
# Who is alerted when the customer hasn't picked a project yet (comma-separated)
DEFAULT_ALERT_PHONES: ""

# Optional: save every conversation for the lead dashboard (dashboard/).
# Neon > your project > Connect > connection string. Leave empty to turn it off.
DATABASE_URL: ""

# Optional: AI answers for questions the FAQ keywords miss, from the Sheet's FAQ and Sites only.
# Key from aistudio.google.com > Get API key. Leave empty to turn it off.
# On Google's free tier, Google may use what is sent (customer questions, your FAQ) to improve its
# products; with billing turned on for the key, it doesn't.
GEMINI_API_KEY: ""
# Optional: another model, e.g. "gemini-3.8-flash". Empty = gemini-3.5-flash-lite
GEMINI_MODEL: ""
